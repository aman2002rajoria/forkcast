# Copy to .env.local and fill in. Never commit .env.local.

# Google Maps Platform key with "Places API (New)" enabled. Also used by /api/place-photo.
GOOGLE_MAPS_API_KEY=
# Gemini key for the optional dish analysis stage.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Search area: Koramangala, 12 km.
CENTER_NAME=Koramangala
CENTER_LAT=12.9352
CENTER_LNG=77.6245
RADIUS_KM=12
# Keep places with at least this many Google reviews, and at most this many places (most-reviewed first).
MIN_REVIEWS=1000
MAX_RESTAURANTS=2000
# PLACE_TYPES=restaurant,cafe,bakery,meal_takeaway
# CELL_RADIUS_M=1500
# STRICT_SPLIT=1        # always split full circles (more calls, never misses a place)
# GOOGLE_QPS=5

# Swiggy MCP. The login stage listens on this URL; Swiggy whitelists http://localhost/callback.
# SWIGGY_REDIRECT_URL=http://localhost/callback
# Places to fetch Swiggy menus for per run, and the pause between Swiggy calls.
SWIGGY_LIMIT=50
SWIGGY_DELAY_MS=2500

# Explore reads data/catalog/restaurants.json when it exists. Force test data with:
# FORKCAST_DATA=test
